{
  "name": "baharal-hugoblox",
  "version": "1.0.0",
  "description": "Bundles the JS libraries modules/blox ships (pnpm vendor:libs)",
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "alpinejs": "^3.15.0",
    "maplibre-gl": "^4.7.1",
    "medium-zoom": "^1.0.8",
    "preact": "^10.27.2",
    "rollup-plugin-delete": "^2.0.0",
    "vite": "^7.1.2",
    "vite-hugo-plugin": "^3.1.0",
    "vite-plugin-static-copy": "^3.1.1"
  },
  "scripts": {
    "vendor:libs": "vite build --config vite.config.js",
    "vendor:libs:watch": "vite build --config vite.config.js --watch",
    "vendor:update-and-build": "pnpm up alpinejs preact maplibre-gl --latest && pnpm vendor:libs"
  },
  "browserslist": "> 1%"
}
